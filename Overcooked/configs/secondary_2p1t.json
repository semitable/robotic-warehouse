{
  "description": "Secondary benchmark: standard two-agent cooperative cooking (one team, onion soup). Every pair is a teammate pair, so it cannot test latent multi-team identification; it checks learning and critic access in a conventional Overcooked-style task.",
  "kitchen": {"layout": "small_kitchen_2p", "horizon": 400, "cook_time": 10, "team_recipes": ["onion"],
              "team_sizes": [2], "team_assignment": "fixed", "team_seed": 0, "delivery_reward": 1.0,
              "wrong_delivery_reward": 0.0, "pot_reward": 0.1, "soup_pickup_reward": 0.2},
  "adapter": {"obs_radius": 3, "probe_radius": 1, "comm_range": 3},
  "ppo": {"rollout_steps": 1024, "sequence_length": 64, "minibatch_chunks": 8, "ppo_epochs": 4, "learning_rate": 0.0002,
          "entropy_coef": 0.05},
  "gate": {"event_reward": 0.5, "min_events": 20, "min_event_response": 0.3, "probes_per_agent": 32, "mirror": false,
           "min_probes": 8, "distance_threshold": 0.5, "ema_beta": 0.35, "min_rounds": 3, "interval": 5,
           "distance_mode": "action_max"},
  "max_gae": {"eta": 0.5, "scale": "shrink", "window": 8},
  "trainer": {"total_timesteps": 2000000, "device": "cpu", "warmup_updates": 100, "eval_interval": 50,
              "eval_episodes": 10, "save_interval": 250, "log_interval": 10, "torch_threads": 1, "audit": true}
}
